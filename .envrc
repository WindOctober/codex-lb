NODE_VERSION="$(tr -d '[:space:]' < .node-version)"
NODE_PREFIX="$PWD/.direnv/node-v$NODE_VERSION"
NODE_BIN="$NODE_PREFIX/node_modules/node/bin"
OPENSPEC_PREFIX="$PWD/.direnv/openspec"
OPENSPEC_BIN="$OPENSPEC_PREFIX/node_modules/.bin"
export OPENSPEC_TELEMETRY=0

if [ -d "$PWD/.venv" ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi

if [ -x "$NODE_BIN/node" ]; then
  PATH_add "$NODE_BIN"
else
  echo "codex-lb: Node $NODE_VERSION is not installed in .direnv yet."
  echo "codex-lb: run ./scripts/setup-node-direnv.sh, then direnv allow"
fi

if [ -x "$OPENSPEC_BIN/openspec" ]; then
  PATH_add "$OPENSPEC_BIN"
else
  echo "codex-lb: OpenSpec CLI is not installed in .direnv yet."
  echo "codex-lb: run npm install --prefix .direnv/openspec --no-save @fission-ai/openspec@1.3.1, then direnv allow"
fi

if [ -d "$HOME/.bun/bin" ]; then
  PATH_add "$HOME/.bun/bin"
fi
